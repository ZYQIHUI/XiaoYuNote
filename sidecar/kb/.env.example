# XiaoYu 环境变量配置模板
# 复制为 .env 并填入真实值：cp .env.example .env
# ⚠️ .env 已在 .gitignore 中排除，请勿提交到版本控制

# OpenAI 兼容 API（必填）
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=sk-xxxx

# 模型配置
KB_CHAT_MODEL=deepseek-ai/DeepSeek-V3
KB_EMBED_MODEL=BAAI/bge-m3

# 可选：Embedding 走不同服务商时单独设置 base_url
# KB_EMBED_BASE_URL=https://api.openai.com/v1

# 超时与重试
KB_TIMEOUT=60
KB_MAX_RETRIES=3
KB_RETRY_BACKOFF=2.0

# 日志级别
KB_LOG_LEVEL=INFO
